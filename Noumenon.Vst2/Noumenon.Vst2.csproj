<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The VST2 wrapper, instrument identity ("Noumenon"): VST.NET's native bridge boots .NET 10
         inside the host process and loads this assembly. The bridge is native and the editor is
         WinForms, so x64 only. Noumenon.Vst2.Fx compiles the same sources as the effect identity. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- LibraryImport (SetParent) generates marshalling stubs that need unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Noumenon.Vst2</AssemblyName>
    <RootNamespace>Noumenon.Vst2</RootNamespace>

    <!-- The runtime the bridge boots reads these from the deployed runtimeconfig when it is the
         first .NET runtime in the host process: the same GC setup as the standalone. -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- Product metadata; PluginIdentity.Version mirrors the version for the host. -->
    <Version>0.1.0</Version>
    <Authors>Noumenon</Authors>
    <Company>Noumenon</Company>
    <Product>Noumenon</Product>
    <Description>Noumenon - a generative ambient loop instrument (VST2 via VST.NET).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VST.NET2-Plugin" Version="2.1.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noumenon.Engine\Noumenon.Engine.csproj" />
    <ProjectReference Include="..\Noumenon.Ui\Noumenon.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Noumenon.Vst2.Tests" />
  </ItemGroup>

  <Import Project="..\Noumenon.Vst2\Deploy.targets" />

</Project>
