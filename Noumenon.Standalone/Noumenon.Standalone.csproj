<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The standalone instrument: the first target and the editor's development host. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Product metadata; the single place the displayed version is set. -->
    <Version>0.1.0</Version>
    <Authors>Noumenon</Authors>
    <Product>Noumenon</Product>
    <Description>Noumenon - a generative ambient loop instrument.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noumenon.Engine\Noumenon.Engine.csproj" />
    <ProjectReference Include="..\Noumenon.Ui\Noumenon.Ui.csproj" />
  </ItemGroup>

</Project>
