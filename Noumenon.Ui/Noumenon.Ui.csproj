<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The owner-drawn WinForms editor shared by the standalone and the plugin wrappers.
         x64 only, like every Windows target (the plugin bridges are native). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Media Foundation decoding (MP3/AAC/WMA/FLAC samples) lives in NAudio.Wasapi; every Windows
         host registers it through Hosting/MediaFoundationDecoding, so it is referenced here once. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noumenon.Engine\Noumenon.Engine.csproj" />
  </ItemGroup>

</Project>
