<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Drives the VST3 wrapper the way a host does — the factory, the parameter list, blocks with
         parameter points and notes, state, the controller's edits, the editor in a window — and
         runs Steinberg's validator over the factory in process (NPlug.Validator ships it with a
         native proxy that hands the validator this assembly's factory). x64 and Windows like the
         plugin. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="NPlug.Validator" Version="1.4.0.380" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noumenon.Engine\Noumenon.Engine.csproj" />
    <ProjectReference Include="..\Noumenon.Vst3\Noumenon.Vst3.csproj" />
  </ItemGroup>

</Project>
