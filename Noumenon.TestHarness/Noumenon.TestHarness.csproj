<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Console: renders the engine to WAV without a GUI or a DAW. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard MIDI file reading for the MIDI-file option; the port classes in the same package are not used. -->
    <PackageReference Include="NAudio.Midi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noumenon.Engine\Noumenon.Engine.csproj" />
  </ItemGroup>

</Project>
